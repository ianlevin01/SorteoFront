# En desarrollo NO hace falta: Vite proxea /api al backend local (localhost:4001).
# En producción (Vercel), definí VITE_API_URL con el origen de la API, SIN /api:
#   VITE_API_URL=https://api.tu-dominio.com
VITE_API_URL=

# Opcional: cambiar a dónde apunta el proxy de /api en desarrollo.
# VITE_API_PROXY=http://localhost:4001
